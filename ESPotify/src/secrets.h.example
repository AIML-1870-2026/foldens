//   3. Run: python get_refresh_token.py
//   4. Paste the printed SPOTIFY_REFRESH_TOKEN value below
#define SPOTIFY_CLIENT_ID     "your-client-id-here"
#define SPOTIFY_CLIENT_SECRET "your-client-secret-here"
#define SPOTIFY_REFRESH_TOKEN ""   // Leave blank to use captive-portal OAuth instead
